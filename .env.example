# Scenario Planning App — Environment Configuration
# -------------------------------------------------------
# 1. Copy this file:   cp .env.example .env
# 2. Replace the three "changeme_*" values below
# 3. Run:              ./setup.sh   (handles everything else)
#
# NEVER commit .env to version control (it's in .gitignore).

# --- Database ---
POSTGRES_DB=scenario_planning
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=changeme_use_a_strong_password

# Keep the password in DATABASE_URL in sync with POSTGRES_PASSWORD above
DATABASE_URL=postgresql://dbuser:changeme_use_a_strong_password@db:5432/scenario_planning

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Security ---
# Generate a secret with:  openssl rand -hex 64
JWT_SECRET=changeme_generate_with_openssl_rand_hex_64

# --- App URLs ---
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:5000
